# Molde do apps/api/.env, que é ignorado pelo git por conter segredo.
# Copie para .env e preencha:
#
#   cp apps/api/.env.example apps/api/.env

# Porta da API. O proxy do vite (apps/web/vite.config.js) aponta para cá.
PORT=3001

# Origens liberadas no CORS. Em desenvolvimento pode ficar vazio: o proxy do
# vite faz as chamadas saírem da mesma origem, então o CORS nem entra em jogo.
# Em produção, o domínio do site.
CORS_ORIGIN=

# Token do Mercado Pago. Um token que começa com TEST- só abre o checkout de
# sandbox: nenhum pagamento real é cobrado. Ver a seção "Pagamentos" do README
# antes de trocar por um de produção — há uma linha de código a mudar junto.
MERCADOPAGO_ACCESS_TOKEN=
